<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form[@name='Product Template']/sheet[@name='product_form']/notebook[1]/page[@name='variants']/p[1]" position="after">
                <group string="Variant Creation Control">
                    <field name="auto_create_variants"/>
                    <button name="action_update_variants" 
                            string="Update Variants" 
                            type="object" 
                            class="btn-primary"
                            invisible="auto_create_variants"/>
                    <field name="allowed_variant_combination_ids" 
                           invisible="auto_create_variants"
                           context="{'default_product_tmpl_id': id}">
                        <list editable="bottom">
                            <field name="product_tmpl_id" column_invisible="1"/>
                            <field name="value_ids" 
                                   widget="many2many_tags"
                                   domain="[('product_tmpl_id', '=', parent.id)]"/>
                            <field name="name"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>